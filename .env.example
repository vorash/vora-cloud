# Server Configuration
HTTP_PORT=5000
GRPC_PORT=50051

# Regions: <region>=<kubeconfig path>, comma separated (REQUIRED)
REGIONS=eu=/etc/vora-cloud/eu.kubeconfig
# Ingress class the apps' Ingresses use (k3s ships Traefik as "traefik")
INGRESS_CLASS=traefik

# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/control_plane?sslmode=disable

# Connection pool. Behind Supabase's session pooler keep DB_MAX_CONNS below its pool size
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# JWT Secret (REQUIRED - minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-very-secure-secret-key-at-least-32-characters-long-please-change-this

# Encrypts project environment variables (REQUIRED - 32 random bytes, base64)
# Generate with: openssl rand -base64 32
SECRETS_KEY=

# Apps are served at <slug>.<region>.<APPS_DOMAIN> (leave empty to not expose apps)
APPS_DOMAIN=cloud.example.com

# The site origin; the dashboard accepts writes only from it (REQUIRED behind a proxy)
PUBLIC_URL=https://cloud.example.com

# Anyone may register (leave off: an admin creates users with POST /api/v1/admin/users)
ALLOW_REGISTRATION=false

# The GitHub App's webhook secret (leave empty to not serve the webhook endpoint)
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Bootstrap API Key (optional - creates admin API key on first run)
BOOTSTRAP_KEY=admin-bootstrap
